# Windows server settings. start.bat creates a private .env from this template.
# Only edit .env on your server; do not upload it to GitHub.
NODE_ENV=production
PORT=3000

# Replace this password with your current Supabase database password.
# URL-encode special characters in the password (for example @ becomes %40).
DATABASE_URL="postgresql://postgres.ohzzeemsxbraxdxvkxmq:REPLACE_WITH_NEW_DATABASE_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Generated automatically on the first start. Keep the same JWT_SECRET on restarts.
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET
INGEST_TOKEN=REPLACE_WITH_GENERATED_SECRET
# Existing accounts stay in Supabase; do not recreate default admin/demo accounts.
SEED_DEFAULT_ACCOUNTS=false

UPSTREAM_GATEWAY="https://api-gateway.gw-lucky-bet.com"
PARTNER_ID="d3edfa27-7cac-4f77-9e6e-4e2fa2d1ab5f"
LANG_CODE="en-001"
POLL_INTERVAL_MS="20000"
# Add your public domain here if the frontend is hosted separately.
ALLOWED_ORIGINS="https://mami12.github.io,http://localhost:8080,http://localhost:3000,http://127.0.0.1:3000"
ODDS_SOCKET="true"
SUBSCRIBE_FULL_LIMIT="100"
PREMATCH_UNPRICED_MS="300000"

# This computer stays online, so keep the sports feed running without visitors.
# Railway used true to pause the feed when idle; set true here only if desired.
IDLE_FEED="false"
IDLE_AFTER_MS="900000"
IDLE_COLD_BOOT_MS="120000"
MATCH_CLOCK_OFFSET_MIN="0"
ISCTRL_SOCKET="true"
ISCTRL_LANG="10"
ISCTRL_SPORT_ID="1"
LUCKYBET_REST="true"
LUCKYBET_REST_MS="60000"
MATCH_PAGE_LIMIT="1000"
SUBSCRIBE_LIVE_LIMIT="200"
PREMATCH_SOON_MIN="1000"
SUBSCRIBE_PREMATCH_LIMIT="100"
CASINO_REAL_MONEY_ENABLED="true"
CASINO_MATH_APPROVED="true"
