# Copy to .env and fill in real values (Railway: paste these in the Variables tab, RAW Editor)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
PORT=3000
NODE_ENV=production

# Upstream sports API (bitgames6205 / gw-lucky-bet)
UPSTREAM_GATEWAY=https://api-gateway.gw-lucky-bet.com
PARTNER_ID=d3edfa27-7cac-4f77-9e6e-4e2fa2d1ab5f
LANG_CODE=en-001

# Collector
POLL_INTERVAL_MS=10000

# CORS for the GitHub Pages frontend, comma separated. Use * while testing.
ALLOWED_ORIGINS=https://YOURNAME.github.io,http://localhost:8080

# Server-side odds subscription (recommended): the backend subscribes to the
# push channel itself - no browser relay needed.
ODDS_SOCKET=true
# full market list (corners, cards, ...) for this many live matches; the rest get
# base markets only. Set SUBSCRIBE_FULL_MARKETS=false to keep base markets only.
SUBSCRIBE_FULL_LIMIT=60
SUBSCRIBE_LIVE_LIMIT=250
SUBSCRIBE_PREMATCH_LIMIT=150

# Shared secret for POST /ingest/odds and /ingest/frames (odds captured elsewhere)
INGEST_TOKEN=change-me
