# Copy to .env and fill in real values (Railway: paste these in the Variables tab, RAW Editor)
# Use the Supabase *pooler* URL: the direct host db.<ref>.supabase.co is IPv6-only and
# only resolves on IPv6-capable networks. Session pooler (IPv4):
#   postgresql://postgres.<project-ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# A dead database should fail the deploy instead of serving a half-alive API.
# Default: on in production, off locally (local dev retries and keeps polling).
# DB_INIT_STRICT=true
PORT=3000
NODE_ENV=production

# Upstream sports API (bitgames6205 / gw-lucky-bet)
UPSTREAM_GATEWAY=https://api-gateway.gw-lucky-bet.com
PARTNER_ID=d3edfa27-7cac-4f77-9e6e-4e2fa2d1ab5f
LANG_CODE=en-001

# Collector
POLL_INTERVAL_MS=10000

# CORS for the GitHub Pages frontend, comma separated. Use * while testing.
ALLOWED_ORIGINS=https://YOURNAME.github.io,http://localhost:8080

# Server-side odds subscription (recommended): the backend subscribes to the
# push channel itself - no browser relay needed.
ODDS_SOCKET=true
# Where odds live. 'memory' (default) keeps prices in RAM and pushes them straight to
# browsers - nothing is written to the database. 'db' mirrors every price into
# odds_current/odds_history (the old behaviour).
ODDS_STORE=memory
# full market list (corners, cards, ...) for this many live matches; the rest get
# base markets only. Set SUBSCRIBE_FULL_MARKETS=false to keep base markets only.
SUBSCRIBE_FULL_LIMIT=60
SUBSCRIBE_LIVE_LIMIT=250
SUBSCRIBE_PREMATCH_LIMIT=150
# how often the pusher re-subscribes: the feed resends the clock+score snapshot on
# every (re)subscribe, so this is what keeps minutes and scores fresh
RESUBSCRIBE_MS=20000

# Shared secret for POST /ingest/odds and /ingest/frames (odds captured elsewhere)
INGEST_TOKEN=change-me
