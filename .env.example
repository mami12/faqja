# Copy to .env and fill in real values (Railway: paste these in the Variables tab, RAW Editor)
# Use the Supabase *pooler* URL: the direct host db.<ref>.supabase.co is IPv6-only and
# only resolves on IPv6-capable networks. Session pooler (IPv4):
#   postgresql://postgres.<project-ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# The database is only the ledger (users / tickets / results) and the raw-frame archive now:
# the match list and prices run from memory, so a dead database does NOT stop the board.
# Set DB_INIT_STRICT=true if you would rather fail the deploy when the ledger is unreachable.
# DB_INIT_STRICT=true

# Where the match list lives: 'memory' (default - the board survives a database outage) or
# 'db' (the previous behaviour: matches stored in Postgres).
MATCH_STORE=memory
PORT=3000
NODE_ENV=production

# Upstream sports API (bitgames6205 / gw-lucky-bet)
UPSTREAM_GATEWAY=https://api-gateway.gw-lucky-bet.com
PARTNER_ID=d3edfa27-7cac-4f77-9e6e-4e2fa2d1ab5f
LANG_CODE=en-001

# Collector
POLL_INTERVAL_MS=10000

# CORS for the GitHub Pages frontend, comma separated. Use * while testing.
ALLOWED_ORIGINS=https://YOURNAME.github.io,http://localhost:8080

# Server-side odds subscription (recommended): the backend subscribes to the
# push channel itself - no browser relay needed.
ODDS_SOCKET=true
# Where odds live. 'memory' (default) keeps prices in RAM and pushes them straight to
# browsers - nothing is written to the database. 'db' mirrors every price into
# odds_current/odds_history (the old behaviour).
ODDS_STORE=memory
# full market list (corners, cards, ...) for this many live matches; the rest get
# base markets only. Set SUBSCRIBE_FULL_MARKETS=false to keep base markets only.
SUBSCRIBE_FULL_LIMIT=60
# 'recent' (default) spends that quota on the matches that just kicked off; 'oldest' keeps
# the previous behaviour. A match opened in the app is always subscribed in full for ~5 min.
SUBSCRIBE_FULL_ORDER=recent
SUBSCRIBE_LIVE_LIMIT=250
SUBSCRIBE_PREMATCH_LIMIT=150
# how often the pusher re-subscribes: the feed resends the clock+score snapshot on
# every (re)subscribe, so this is what keeps minutes and scores fresh
RESUBSCRIBE_MS=20000

# ── What a subscription costs (Railway bills CPU per minute) ──────────────────────────
# Live keeps the ~20s cadence above (that is the clock/score refresh). Prematch is tiered:
# a fixture kicking off within PREMATCH_SOON_MIN is refreshed every PREMATCH_SOON_MS, the
# rest every PREMATCH_REFRESH_MS -- prices live in memory for 6h, so an hour-old snapshot
# of a fixture hours away is still bettable. A fixture the feed has not priced yet is asked
# for every PREMATCH_UNPRICED_MS until it gets a price: the board hides unpriced matches, so
# without that a new fixture would stay invisible until the next hourly pass.
PREMATCH_SOON_MIN=30
PREMATCH_SOON_MS=300000
PREMATCH_REFRESH_MS=3600000
PREMATCH_UNPRICED_MS=60000
# prematch prices older than this are refused (the hourly tier + margin); live keeps 120s
PREMATCH_STALE_MS=5400000
# PREMATCH_REFRESH_MS=0 restores the old behaviour: every group follows the live cadence.

# ── Idle mode: stop paying while nobody is on the board ───────────────────────────────
# With no visitor the feed is paused - upstream socket closed, collector, database probe and
# settlement stopped - so nothing goes out and the platform may put the instance to sleep
# (enable Railway Serverless for the service; it applies on the next deploy). The first
# request wakes it: the board shows "Kuotat po rifreskohen..." for the seconds the first feed
# cycle takes, and a bet is refused meanwhile instead of selling a price from before the pause.
#   IDLE_FEED=false            never pause (previous behaviour)
#   IDLE_AFTER_MS              pause this long after the last visitor
#   IDLE_COLD_BOOT_MS          shorter window when nobody has visited since boot
#   IDLE_STOP_DB_PROBE=false   keep the 15s probe while idle (it is outbound traffic, and
#                              outbound traffic is what prevents the platform's sleep)
IDLE_FEED=true
IDLE_AFTER_MS=900000
IDLE_COLD_BOOT_MS=120000
IDLE_STOP_DB_PROBE=true

# The same selection is priced by two books at once (odds ids "10:…" and "12:L:…") and both
# used to write the same key, so the board showed whichever frame arrived last - a price that
# changed and then changed back. Pin one book per selection (the one match-info reports for
# the match wins). ODDS_PROVIDER_PIN=false restores last-writer-wins.
ODDS_PROVIDER_PIN=true
# how long a pinned book may stay silent before another one may take the selection over (ms)
ODDS_PROVIDER_TAKEOVER_MS=60000
# The feed frames some groups twice: once with the line in the odds id ("Total 2.5") and once
# with no line at all, where the line can only be invented ("#1"). Showing both put the same
# selection on the board twice with two independently moving prices; the invented copy is hidden
# (a group that is only ever line-less keeps it). Set to false to see both again.
ODDS_HIDE_SYNTHETIC_LINES=true
# A match is only ended when the feed says so, as long as we saw its clock within this window.
# The kickoff-based clock alone is an approximation (late kickoff / long break) and marking a
# match ended hides it from the board and unsubscribes it - matches used to vanish around 70'.
FEED_EVIDENCE_MS=900000

# Shared secret for POST /ingest/odds and /ingest/frames (odds captured elsewhere)
INGEST_TOKEN=change-me

# ── Ledger + the React app (users, tickets, admin panel) ─────────────────────────────
# Sign login tokens with a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=7d
# Default accounts are created on first boot when they are missing:
#   admin / admin123  (ADMIN)   and   demo / demo  (PLAYER, 1000 LEK)
# CHANGE THESE, or set SEED_DEFAULT_ACCOUNTS=false, before going live.
SEED_DEFAULT_ACCOUNTS=true
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
DEMO_USER=demo
DEMO_PASSWORD=demo

# How often finished matches are graded and paid out. The pass is idempotent.
SETTLE_INTERVAL_MS=30000
